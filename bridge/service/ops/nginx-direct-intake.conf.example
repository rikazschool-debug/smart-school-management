# Exact /iclock/cdata and /iclock/getrequest locations only. TLS mandatory.
auth_basic off;
client_max_body_size 2m;
auth_request /_adms/check;
if ($https != on) { return 403; }
limit_except GET POST { deny all; }
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-ADMS-Transport direct-https;
proxy_set_header X-ADMS-HTTPS $https;
include /etc/nginx/snippets/rikaz-adms-edge-key.conf;
proxy_set_header Authorization "";
proxy_set_header X-ADMS-Device "";
proxy_set_header X-ADMS-Timestamp "";
proxy_set_header X-ADMS-Signature "";
proxy_set_header X-Original-URL "";
proxy_set_header X-Rewrite-URL "";
proxy_set_header X-Forwarded-Prefix "";
proxy_connect_timeout 5s;
proxy_read_timeout 30s;
proxy_send_timeout 30s;
proxy_pass http://unix:/run/rikaz-adms/intake.sock:;
