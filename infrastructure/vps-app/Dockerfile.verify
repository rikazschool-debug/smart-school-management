# Isolated verification only. No credentials, production network, or deployment.
ARG NODE_IMAGE=node@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
ARG BUN_IMAGE=oven/bun@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7
FROM ${BUN_IMAGE} AS bun-tool
FROM ${NODE_IMAGE} AS verify
COPY --from=bun-tool /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY vite.config.ts vitest.config.ts tsconfig.json ./
COPY src ./src
COPY public ./public
ENV VITE_SUPABASE_URL=http://127.0.0.1:43219 \
    VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_RIKAZ_ISOLATED_REVIEW_ONLY \
    DO_NOT_TRACK=1
CMD ["node", "node_modules/vitest/vitest.mjs", "run"]
